# Credenciais do Mercado Livre
ML_APP_ID=seu_app_id_aqui
ML_SECRET=seu_secret_aqui
ML_AFFILIATE_TAG=sua_tag_afiliado

# Caminho do arquivo de credenciais OAuth2 do YouTube (baixe no Google Cloud Console)
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json

# Modelo do Ollama a ser usado (ex: llama3, mistral, phi3)
OLLAMA_MODEL=llama3

# URL base do servidor Ollama (padrão: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Limite de postagens por dia
DAILY_LIMIT=3

# Nicho de produtos para buscar no Mercado Livre
NICHE=eletrônicos
